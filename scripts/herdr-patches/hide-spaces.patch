diff --git a/src/ui/sidebar.rs b/src/ui/sidebar.rs
index cbf6f1a9..667ef5f8 100644
--- a/src/ui/sidebar.rs
+++ b/src/ui/sidebar.rs
@@ -27,7 +27,21 @@ pub(crate) struct AgentPanelEntry {
     pub tokens: std::collections::HashMap<String, String>,
 }
 
+// ui.sidebar.spaces.hidden: every layout helper (rendering and mouse
+// hit-testing alike) funnels through sidebar_section_heights, so a single
+// flag keeps the patch to one choke point instead of threading the option
+// through every call site.
+static HIDE_SPACES: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(false);
+
+pub(crate) fn set_hide_spaces(hidden: bool) {
+    HIDE_SPACES.store(hidden, std::sync::atomic::Ordering::Relaxed);
+}
+
 fn sidebar_section_heights(total_height: u16, split_ratio: f32) -> (u16, u16) {
+    if HIDE_SPACES.load(std::sync::atomic::Ordering::Relaxed) {
+        return (0, total_height);
+    }
+
     if total_height == 0 {
         return (0, 0);
     }
