#!/usr/bin/env bash
# herdr-rebuild — build herdr from source with local patches and install it.
#
# herdr update installs the official binary, which loses the patches in
# ~/.dotfiles/scripts/herdr-patches/; run this afterwards to restore them.
#
# Requirements:
#   - rust (stable; the repo's rust-toolchain.toml pins the version)
#   - the exact zig the tag's CI pins, managed by mise (mise's zig is the
#     official ziglang.org build). v0.9.0 and older pinned zig 0.15 via
#     brew's patched formula; v0.9.1 switched to official zig 0.16.0.
#
# The zig for a ref is derived from herdr's CI, never guessed: an unexpected
# ref, a missing version, or an unsettable HERDR_ZIG stops the build loudly
# instead of silently building with some other zig.
#
# Usage: herdr-rebuild [ref]        # git ref to build, default: latest tag
#        HERDR_ZIG=/path/to/zig herdr-rebuild v0.9.3   # explicit zig override

set -euo pipefail

ref="${1:-}"
patches_dir="$HOME/.dotfiles/scripts/herdr-patches"
build_dir="${XDG_CACHE_HOME:-$HOME/.cache}/herdr-build"

# a missing patches dir must fail loudly — silently building stock herdr
# is the one outcome this script exists to prevent
[[ -d "$patches_dir" ]] || { echo "herdr-rebuild: $patches_dir not found" >&2; exit 1; }

# The vendored libghostty-vt build needs the same zig the tag's CI pinned:
# v0.9.0 and older used 0.15 (brew's patched formula), v0.9.1+ official
# 0.16.0. No fallbacks — resolve exactly one zig or set HERDR_ZIG.
resolve_zig() {
  local ref="$1"
  if [[ -n "${HERDR_ZIG:-}" ]]; then
    [[ -x "$HERDR_ZIG" ]] || { echo "herdr-rebuild: HERDR_ZIG not executable: $HERDR_ZIG" >&2; exit 1; }
    zig_bin="$HERDR_ZIG"
    return
  fi

  local ver dir
  case "$ref" in
    v0.9.*) ver=0.16.0 ;;
    v0.*) ver=0.15.2 ;;
    *) { echo "herdr-rebuild: no zig mapping for ref '$ref'; set HERDR_ZIG" >&2; exit 1; } ;;
  esac
  dir="$(mise where "zig@$ver" 2>/dev/null)" || true
  if [[ -z "$dir" || ! -x "$dir/bin/zig" ]]; then
    echo "herdr-rebuild: ref '$ref' requires zig $ver (mise install zig@$ver); HERDR_ZIG can override" >&2
    exit 1
  fi
  zig_bin="$dir/bin/zig"
}

if [[ -d "$build_dir/.git" ]]; then
  git -C "$build_dir" fetch --tags origin
else
  git clone https://github.com/ogulcancelik/herdr "$build_dir"
fi

cd "$build_dir"
if [[ -z "$ref" ]]; then
  ref=$(git tag --sort=-v:refname | sed -n 1p)
fi
[[ -n "$ref" ]] || { echo "herdr-rebuild: no release tag found" >&2; exit 1; }
git checkout --force "$ref"
git clean -fd

resolve_zig "$ref"
echo "herdr-rebuild: using zig $zig_bin ($("$zig_bin" version))"

for p in "$patches_dir"/*.patch; do
  [[ -e "$p" ]] || continue
  echo "applying ${p##*/}"
  # --3way so patches keep applying across small upstream drift;
  # a real conflict stops the build here instead of shipping unpatched
  git apply --3way "$p"
done

zig_dir="$(dirname "$zig_bin")"
PATH="$zig_dir:$HOME/.cargo/bin:$PATH" RUSTUP_TOOLCHAIN=stable ZIG="$zig_bin" \
  cargo build --release

install -d "$HOME/.local/bin"
backup="$HOME/.local/bin/herdr-stock"
[[ -f "$HOME/.local/bin/herdr" && ! -f "$backup" ]] \
  && cp "$HOME/.local/bin/herdr" "$backup"
install -m 755 target/release/herdr "$HOME/.local/bin/herdr"

echo "installed patched herdr ($ref) -> ~/.local/bin/herdr (stock backup: $backup)"
echo "restart: herdr server stop && herdr"